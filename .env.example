# Copy this file to .env and fill in the values:  cp .env.example .env

# Local PostgreSQL started by `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://cirkit:cirkit@localhost:5433/cirkit"

# Generate your own with: npx auth@latest secret   (never commit the real value)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continue with GitHub". Create an OAuth App at
# https://github.com/settings/developers  (Settings > Developer settings > OAuth Apps)
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: "Continue with Google". Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origin: http://localhost:3000
#   Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
